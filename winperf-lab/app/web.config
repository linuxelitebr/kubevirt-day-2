<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <appSettings>
    <!-- Calibre para ~2-4s numa VM ociosa; e' o "custo de cold-start" (JIT + priming simulado). -->
    <add key="WarmupIterations" value="40000000" />
  </appSettings>
  <system.web>
    <compilation targetFramework="4.0" debug="false" />
    <httpRuntime targetFramework="4.0" />
  </system.web>
  <system.webServer>
    <!-- App Init: ao dar preload no pool, o IIS dispara /Default.aspx sozinho e serve Startup.htm ate' aquecer.
         So tem efeito quando o app pool esta' com startMode=AlwaysRunning e a app com preloadEnabled=true
         (o script setup-iis.ps1 -Warmup on liga isso). -->
    <applicationInitialization doAppInitAfterRestart="true">
      <add initializationPage="/Default.aspx" />
    </applicationInitialization>
  </system.webServer>
</configuration>
