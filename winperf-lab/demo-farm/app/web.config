<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <appSettings>
    <!-- iteracoes do passo de compute (backend constante e local). Calibre se quiser. -->
    <add key="ComputeIters" value="2000000" />
    <!-- tamanho do corpo comprimivel (KB) pra a compressao dinamica aparecer no tamanho de rede. 0 = off. -->
    <add key="PayloadKB" value="200" />
    <!-- modo "app pesada de memoria": MB alocados e segurados no start do pool (working set + LOH). 0 = leve. -->
    <add key="MemLoadMB" value="0" />
  </appSettings>
  <system.web>
    <compilation targetFramework="4.0" debug="false" />
    <httpRuntime targetFramework="4.0" />
  </system.web>
  <system.webServer>
    <!-- Espelha o cliente: compressao dinamica DESLIGADA. Ligue (true) pra medir o ganho da compressao. -->
    <urlCompression doStaticCompression="false" doDynamicCompression="false" />
    <defaultDocument>
      <files>
        <clear />
        <add value="Default.aspx" />
      </files>
    </defaultDocument>
  </system.webServer>
</configuration>
